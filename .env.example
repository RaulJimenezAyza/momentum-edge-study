# Copy to .env and fill in. Paper mode needs NOTHING here.
#
# Testnet keys: https://testnet.binance.vision/
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Real keys. Only used when mode: live. Restrict to "Spot Trading" and
# IP-whitelist them. NEVER enable withdrawals.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Live mode refuses to start unless this is exactly YES.
TRADING_LIVE_CONFIRM=NO
